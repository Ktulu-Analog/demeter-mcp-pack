# Configuration mcp-grist
# Copiez ce fichier en .env et renseignez vos valeurs

# Clé API Grist (obligatoire)
# Obtenez-la sur : https://docs.getgrist.com/account (section API)
GRIST_API_KEY=votre_cle_api

# URL de base de votre instance Grist (obligatoire)
# Instance cloud officielle :
GRIST_BASE_URL=https://docs.getgrist.com
# Instance auto-hébergée (exemple) :
# GRIST_BASE_URL=https://grist.mondomaine.com

# Paramètres du serveur MCP (optionnels)
# MCP_HOST=0.0.0.0
# MCP_PORT=6502
# MCP_PATH=/mcp
